            if mode == 'api_key':
                key = d.get('OPENAI_API_KEY', '')
                email = f'Key: {key[:7]}...{key[-4:]}' if len(key) > 12 else 'API Key'
                plan = 'api'
            else:
                tokens = d.get('tokens', {})
                for tok_k in ['id_token', 'access_token']:
                    tok = tokens.get(tok_k, '')
                    if tok and '.' in tok:
                        try:
                            import base64
                            b64 = tok.split('.')[1]
                            b64 += '=' * (-len(b64) % 4)
                            claims = json.loads(base64.urlsafe_b64decode(b64))
                            if email == 'unknown':
                                email = claims.get('email') or claims.get('https://api.openai.com/profile', {}).get('email', 'unknown')
                            if plan == 'unknown':
                                ac = claims.get('https://api.openai.com/auth', {})
                                if isinstance(ac, dict):
                                    plan = ac.get('chatgpt_plan_type', 'unknown')
                            if sub_days is None and not sub_expired:
                                ac = claims.get('https://api.openai.com/auth', {})
                                if isinstance(ac, dict):
                                    su = ac.get('chatgpt_subscription_active_until')
                                    if su:
                                        dt = datetime.datetime.fromisoformat(su.replace('Z', '+00:00'))
                                        now = datetime.datetime.now(datetime.timezone.utc)
                                        diff = (dt - now).days
                                        if diff < 0:
                                            sub_expired = True
                                        else:
                                            sub_days = diff
                        except Exception:
                            pass
                if plan == 'unknown':
                    plan = 'chatgpt'
        except Exception:
            pass

    # Fetch usage
    r1 = '\033[2musage: unavailable\033[0m'
    r2 = ''
    access_token = tokens.get('access_token')
    account_id = tokens.get('account_id')
    if plan == 'api':
        r1 = '\033[2musage: api key mode\033[0m'
        r2 = '\033[2m(direct api billing)\033[0m'
    elif not access_token:
        r1 = '\033[33musage: no token\033[0m'
        r2 = '\033[2m(run codex login)\033[0m'
    else:
        headers = {
            'Authorization': f'Bearer {access_token}',
            'User-Agent': 'codex_cli_rs',
            'Accept': 'application/json',
        }
        if account_id:
            headers['ChatGPT-Account-Id'] = account_id
        req = urllib.request.Request('https://chatgpt.com/backend-api/codex/usage', headers=headers)
        for attempt in range(2):
            try:
                with urllib.request.urlopen(req, timeout=5) as resp:
                    u = json.loads(resp.read().decode())
                    rl = u.get('rate_limit', {})
                    pw = rl.get('primary_window', {})
                    sw = rl.get('secondary_window', {})
                    now_ts = time.time()

                    p_used = pw.get('used_percent', 0)
                    p_rst = pw.get('reset_at', 0)
                    p_rem = max(0, p_rst - now_ts)
                    p_warn = ' \033[31m⚠\033[0m' if p_used >= 100 else (' \033[33m⚠\033[0m' if p_used >= 90 else '')
                    r1 = f'5h [{make_bar(p_used)}] {p_used:>3}% \033[2m· {format_delta(p_rem)}\033[0m{p_warn}'

                    s_used = sw.get('used_percent', 0)
                    s_rst = sw.get('reset_at', 0)
                    s_rem = max(0, s_rst - now_ts)
                    s_warn = ' \033[31m⚠\033[0m' if s_used >= 100 else (' \033[33m⚠\033[0m' if s_used >= 90 else '')
                    r2 = f'wk [{make_bar(s_used)}] {s_used:>3}% \033[2m· {format_delta(s_rem)}\033[0m{s_warn}'
                    break
            except urllib.error.HTTPError as e:
                if e.code == 403 and attempt == 0:
                    time.sleep(0.3)
                    continue
                if e.code in (401, 403):
                    r1 = '\033[33m⚡ usage: session expired\033[0m'
                    r2 = '\033[2m(run codex login to refresh)\033[0m'
                elif e.code == 429:
                    r1 = '\033[33m⚡ usage: rate limited\033[0m'
                    r2 = '\033[2m(try again shortly)\033[0m'
                else:
                    r1 = f'\033[31musage: http {e.code}\033[0m'
                break
            except Exception as e:
                if 'timed out' in str(e).lower():
                    r1 = '\033[2musage: timed out\033[0m'
                else:
                    r1 = '\033[2musage: unavailable (offline)\033[0m'
                break

    return {
        'name': pname,
        'email': email,
        'plan': plan,
        'sub_days': sub_days,
        'sub_expired': sub_expired,
        'is_active': (pname == active_name),
        'r1': r1,
        'r2': r2,
    }

target = '$target'
if target == 'all' or not target:
    profiles = sorted([os.path.basename(p) for p in glob.glob(os.path.join(profiles_dir, '*')) if os.path.isdir(p)])
else:
    profiles = [target] if os.path.isdir(os.path.join(profiles_dir, target)) else []

if not profiles:
    sys.exit(0)

with ThreadPoolExecutor(max_workers=min(4, max(1, len(profiles)))) as pool:
