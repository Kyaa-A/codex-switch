get_profile_names() {
    local profiles=()
    if [[ -d "$PROFILES_DIR" ]]; then
        for dir in "$PROFILES_DIR"/*/; do
            [[ -d "$dir" ]] || continue
            profiles+=("$(basename "$dir")")
        done
    fi
    echo "${profiles[@]}"
}

get_profile_info() {
    local name="$1"
    local auth_file="$PROFILES_DIR/$name/auth.json"
