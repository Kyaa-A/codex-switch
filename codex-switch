cmd_save() {
    local name="${1:-}"

    show_mini_banner

    if [[ -z "$name" ]]; then
        echo -e "  ${BOLD}Save current Codex session as a profile${RST}"
        echo ""
        name=$(input_prompt "${ICO_KEY} Profile name")
        if [[ -z "$name" ]]; then
            msg_error "Profile name cannot be empty"
            exit 1
        fi
    fi

    name=$(echo "$name" | tr -cd '[:alnum:]_-')
    if [[ -z "$name" ]]; then
        msg_error "Profile name must contain alphanumeric characters, '-', or '_'"
        exit 1
    fi

    ensure_profiles_dir

    if [[ ! -f "$AUTH_FILE" ]]; then
        msg_error "No credentials found at ${ULINE}${AUTH_FILE}${RST}"
        msg_info "Login first: ${BOLD}codex login${RST}"
        exit 1
    fi

    local profile_dir="$PROFILES_DIR/$name"
    if [[ -d "$profile_dir" ]]; then
        echo ""
        msg_warn "Profile ${BOLD}'$name'${RST} already exists"
        if ! confirm "Overwrite?" "y"; then
            echo ""
            msg_info "Cancelled"
            exit 0
        fi
    fi

    mkdir -p "$profile_dir"
    cp "$AUTH_FILE" "$profile_dir/auth.json"
    echo "$name" > "$ACTIVE_FILE"

    echo ""
    msg_success "Profile ${BOLD}${BGREEN}'$name'${RST} saved!"
    echo ""

    get_profile_info "$name"
    print_profile_card "$name" "$PROF_EMAIL" "$PROF_PLAN" "true" "$PROF_SUB"
    echo ""
}

cmd_use() {
    local name="${1:-}"

    show_mini_banner
    ensure_profiles_dir

    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    if [[ ${#profile_arr[@]} -eq 0 ]]; then
        msg_warn "No profiles saved yet"
        echo ""
        msg_info "Save your current session first:"
        echo -e "    ${BOLD}codex-switch save <name>${RST}"
        exit 1
    fi

    local active
    active=$(get_active_profile)

    if [[ -z "$name" ]]; then
        local display_options=()
        for p in "${profile_arr[@]}"; do
            get_profile_info "$p"
            local marker=""
            if [[ "$p" == "$active" ]]; then
                marker=" ${GREEN}(active)${RST}"
            fi
            display_options+=("${BOLD}${p}${RST}  ${DIM}${PROF_EMAIL}  [${PROF_PLAN}]${RST}${marker}")
        done

        if interactive_select "${ICO_SWAP} Select Codex account to switch to:" "${display_options[@]}"; then
            name="${profile_arr[$SELECTED_INDEX]}"
        else
            exit 0
        fi
    fi

    local profile_dir="$PROFILES_DIR/$name"
    if [[ ! -f "$profile_dir/auth.json" ]]; then
        msg_error "Profile ${BOLD}'$name'${RST} not found!"
        echo ""
        exit 1
    fi

    if [[ "$name" == "$active" ]]; then
        msg_info "Already on profile ${BOLD}'$name'${RST}"
        exit 0
    fi

    # Auto-save current auth before switching so tokens are never lost!
    if [[ -n "$active" && -f "$AUTH_FILE" ]]; then
        local current_dir="$PROFILES_DIR/$active"
        mkdir -p "$current_dir"
        cp "$AUTH_FILE" "$current_dir/auth.json"
        msg_info "Auto-saved current profile '${BOLD}${active}${RST}'"
    fi

    # Switch auth
    cp "$profile_dir/auth.json" "$AUTH_FILE"
    echo "$name" > "$ACTIVE_FILE"

    echo ""
    msg_success "Switched to ${BOLD}${BGREEN}'$name'${RST}!"
    echo ""

    get_profile_info "$name"
    print_profile_card "$name" "$PROF_EMAIL" "$PROF_PLAN" "true" "$PROF_SUB"

    echo ""
    msg_info "All your previous session history is preserved!"
    msg_info "Run ${BOLD}codex resume${RST} or use ${BOLD}/resume${RST} to continue any chat."
    echo ""
}

