}

get_active_profile() {
    if [[ -f "$ACTIVE_FILE" ]]; then
        cat "$ACTIVE_FILE"
    else
        echo ""
    fi
}

repeat_char() {
    local char="$1" count="$2"
    printf "%0.s${char}" $(seq 1 "$count")
}

center() {
    local text="$1" width="${2:-$TERM_WIDTH}"
    local stripped
    stripped=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local len=${#stripped}
    local pad=$(( (width - len) / 2 ))
    [[ $pad -lt 0 ]] && pad=0
    printf "%${pad}s" ""
    echo -e "$text"
}

hr() {
    local char="${1:-─}" color="${2:-$DIM}"
    local width=$((TERM_WIDTH > 60 ? 60 : TERM_WIDTH))
    echo -e "${color}$(repeat_char "$char" "$width")${RST}"
}

# Extract account metadata from Codex auth.json
extract_codex_info() {
    local auth_file="$1"
    if [[ -f "$auth_file" ]] && command -v python3 &>/dev/null; then
        python3 -c "
import json, base64

try:
    with open('$auth_file') as f:
        d = json.load(f)
    mode = d.get('auth_mode', 'unknown')
    email = 'unknown'
    account_id = 'unknown'

    if mode == 'chatgpt':
        tokens = d.get('tokens', {})
        account_id = tokens.get('account_id', 'unknown')
        id_tok = tokens.get('id_token', '')
        if id_tok and '.' in id_tok:
            try:
                b64 = id_tok.split('.')[1]
                b64 += '=' * (-len(b64) % 4)
                payload = json.loads(base64.urlsafe_b64decode(b64))
                email = payload.get('email', 'unknown')
            except:
                pass
    elif mode == 'api_key':
        key = d.get('OPENAI_API_KEY', '')
        email = f'Key: {key[:7]}...{key[-4:]}' if len(key) > 12 else 'API Key'

    print(f'{mode}|{email}|{account_id}')
except Exception as e:
    print('unknown|unknown|unknown')
" 2>/dev/null
    else
        echo "unknown|unknown|unknown"
    fi
}

# Count stored local sessions
count_sessions() {
    if [[ -d "$CODEX_DIR/sessions" ]]; then
        find "$CODEX_DIR/sessions" -name "*.jsonl" 2>/dev/null | wc -l
    elif [[ -f "$CODEX_DIR/session_index.jsonl" ]]; then
        wc -l < "$CODEX_DIR/session_index.jsonl" 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

