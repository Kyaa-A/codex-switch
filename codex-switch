repeat_char() {
    local char="$1" count="$2"
    printf "%0.s${char}" $(seq 1 "$count")
}

center() {
    local text="$1" width="${2:-$TERM_WIDTH}"
    local stripped
    stripped=$(echo -e "$text" | sed 's/\x1b\[[0-9;]*m//g')
    local len=${#stripped}
    local pad=$(( (width - len) / 2 ))
    [[ $pad -lt 0 ]] && pad=0
    printf "%${pad}s" ""
    echo -e "$text"
}

hr() {
    local char="${1:-─}" color="${2:-$DIM}"
    local width=$((TERM_WIDTH > 60 ? 60 : TERM_WIDTH))
    echo -e "${color}$(repeat_char "$char" "$width")${RST}"
}

# Extract account metadata from Codex auth.json
extract_codex_info() {
    local auth_file="$1"
    if [[ -f "$auth_file" ]] && command -v python3 &>/dev/null; then
        python3 -c "
import json, base64, datetime

try:
    with open('$auth_file') as f:
        d = json.load(f)
    mode = d.get('auth_mode', 'unknown')
    email = 'unknown'
    plan = 'unknown'
    sub_badge = 'unknown'

    if mode == 'chatgpt':
        tokens = d.get('tokens', {})
        for tok_key in ['id_token', 'access_token']:
            tok = tokens.get(tok_key, '')
            if tok and '.' in tok:
                try:
                    b64 = tok.split('.')[1]
                    b64 += '=' * (-len(b64) % 4)
                    claims = json.loads(base64.urlsafe_b64decode(b64))
                    if email == 'unknown':
                        email = claims.get('email') or claims.get('https://api.openai.com/profile', {}).get('email', 'unknown')
                    if plan == 'unknown':
                        auth_claims = claims.get('https://api.openai.com/auth', {})
                        if isinstance(auth_claims, dict):
                            plan = auth_claims.get('chatgpt_plan_type', 'unknown')
                    if sub_badge == 'unknown':
                        auth_claims = claims.get('https://api.openai.com/auth', {})
                        if isinstance(auth_claims, dict):
                            sub_until = auth_claims.get('chatgpt_subscription_active_until')
                            if sub_until:
                                dt = datetime.datetime.fromisoformat(sub_until.replace('Z', '+00:00'))
                                now = datetime.datetime.now(datetime.timezone.utc)
                                delta = (dt - now).days
                                if delta < 0:
                                    sub_badge = 'expired'
                                else:
                                    sub_badge = f'valid:{delta}d'
                except Exception:
                    pass
        if plan == 'unknown':
            plan = 'chatgpt'
    elif mode == 'api_key':
        key = d.get('OPENAI_API_KEY', '')
        email = f'Key: {key[:7]}...{key[-4:]}' if len(key) > 12 else 'API Key'
        plan = 'api'

    print(f'{email}|{plan}|{sub_badge}')
except Exception as e:
    print('unknown|unknown|unknown')
" 2>/dev/null
    else
        echo "unknown|unknown|unknown"
    fi
}

# Count stored local sessions
count_sessions() {
    if [[ -d "$CODEX_DIR/sessions" ]]; then
        find "$CODEX_DIR/sessions" -name "*.jsonl" 2>/dev/null | wc -l
    elif [[ -f "$CODEX_DIR/session_index.jsonl" ]]; then
        wc -l < "$CODEX_DIR/session_index.jsonl" 2>/dev/null || echo "0"
    else
        echo "0"
    fi
}

# Fetch and display live quota & rate limits for a Codex profile
show_codex_usage() {
    local prof_name="$1"
    local auth_file="$2"

    if [[ ! -f "$auth_file" ]]; then
        msg_error "Auth file for '$prof_name' not found"
        return 1
    fi

    if ! command -v python3 &>/dev/null; then
        msg_warn "python3 required to query live usage"
        return 1
    fi

    python3 -c "
import json, time, datetime, urllib.request, urllib.error

def format_delta(seconds):
    if seconds <= 0:
        return 'now'
    m, s = divmod(int(seconds), 60)
    h, m = divmod(m, 60)
    d, h = divmod(h, 24)
    parts = []
    if d > 0:
        parts.append(f'{d}d')
    if h > 0 or d > 0:
        parts.append(f'{h}h')
    parts.append(f'{m}m')
    return ' '.join(parts)

def color_bar(percent, width=22):
    percent = max(0, min(100, percent))
    filled = int(round((percent / 100.0) * width))
    empty = width - filled
    if percent >= 90:
        c = '\033[38;2;239;68;68m'
    elif percent >= 70:
        c = '\033[38;2;245;158;11m'
    else:
        c = '\033[38;2;16;163;127m'
    return f'{c}{\"█\" * filled}\033[2m{\"░\" * empty}\033[0m'

try:
    with open('$auth_file') as f:
        d = json.load(f)
    tokens = d.get('tokens', {})
    access_token = tokens.get('access_token')
    account_id = tokens.get('account_id')
    
    if not access_token:
        print('  \033[33m[!] No access token available for this profile\033[0m')
        exit(0)

    headers = {
        'Authorization': f'Bearer {access_token}',
        'User-Agent': 'codex_cli_rs',
        'Accept': 'application/json',
    }
    if account_id:
        headers['ChatGPT-Account-Id'] = account_id

    req = urllib.request.Request('https://chatgpt.com/backend-api/codex/usage', headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=5) as resp:
            u = json.loads(resp.read().decode())
    except urllib.error.HTTPError as e:
        if e.code == 401:
            print('  \033[31m[-] Session expired (HTTP 401). Run codex login to re-authenticate this account.\033[0m')
        else:
            print(f'  \033[31m[-] Usage query failed: HTTP {e.code}\033[0m')
        exit(0)
    except Exception as e:
        print(f'  \033[31m[-] Usage query network error: {e}\033[0m')
        exit(0)

    rl = u.get('rate_limit', {})
    pw = rl.get('primary_window', {})
    sw = rl.get('secondary_window', {})
    now_ts = time.time()

    p_used = pw.get('used_percent', 0)
    p_rst = pw.get('reset_at', 0)
    p_rem = max(0, p_rst - now_ts)
    p_time = datetime.datetime.fromtimestamp(p_rst).strftime('%-I:%M %p') if p_rst else 'unknown'

    s_used = sw.get('used_percent', 0)
    s_rst = sw.get('reset_at', 0)
    s_rem = max(0, s_rst - now_ts)
    s_time = datetime.datetime.fromtimestamp(s_rst).strftime('%a %-I:%M %p') if s_rst else 'unknown'

    print(f'  \033[1m📊 Quota & Rate Limits\033[0m \033[2m($prof_name)\033[0m')
    print('    \033[2m┌────────────────────────────────────────────────────────┐\033[0m')
    p_warn = '  \033[31m⚠ limit reached\033[0m' if p_used >= 100 else ('  \033[33m⚠ high\033[0m' if p_used >= 90 else '')
    print(f'    \033[2m│\033[0m  \033[1m5-Hour Limit:\033[0m   {p_used:>2}% used{p_warn}')
    print(f'    \033[2m│\033[0m  [{color_bar(p_used)}] \033[2mresets in {format_delta(p_rem)} ({p_time})\033[0m')
    print('    \033[2m│\033[0m')
    s_warn = '  \033[31m⚠ limit reached\033[0m' if s_used >= 100 else ('  \033[33m⚠ high\033[0m' if s_used >= 90 else '')
    print(f'    \033[2m│\033[0m  \033[1mWeekly Limit:\033[0m   {s_used:>2}% used{s_warn}')
    print(f'    \033[2m│\033[0m  [{color_bar(s_used)}] \033[2mresets in {format_delta(s_rem)} ({s_time})\033[0m')
    print('    \033[2m└────────────────────────────────────────────────────────┘\033[0m')
except Exception as e:
    pass
" 2>/dev/null
}

