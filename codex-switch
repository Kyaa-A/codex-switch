    echo ""

    # Ask for profile name
    local name
    name=$(input_prompt "${ICO_KEY} Save new account as" "")
    if [[ -n "$name" ]]; then
        cmd_save "$name"
    else
        msg_info "Skipped saving. You can save later with: ${BOLD}codex-switch save <name>${RST}"
    fi
