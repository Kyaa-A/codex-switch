            msg_success "Session is ${BOLD}${GREEN}valid${RST} — ${live_status}"
        else
            msg_warn "Status: ${live_status}"
        fi
    fi

    local scount
    scount=$(count_sessions)
    echo ""
    msg_info "Shared session pool: ${BOLD}${scount}${RST} conversations available to ${BOLD}codex resume${RST}"
    echo ""
