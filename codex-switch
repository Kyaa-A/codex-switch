# ── Interactive Menu ───────────────────────────────────────────

interactive_select() {
    local prompt="$1"
    shift
    local options=("$@")
    local count=${#options[@]}
    local selected=0

    if [[ $count -eq 0 ]]; then
        echo -e "  ${RED}${ICO_CROSS} No options available${RST}"
        return 1
    fi

    echo -ne "$HIDE_CURSOR"
    trap 'echo -ne "$SHOW_CURSOR"' EXIT INT TERM

    echo -e "  ${BOLD}${prompt}${RST}"
    echo -e "  ${DIM}Use ↑↓ arrows (or j/k) to navigate, Enter to select, q to cancel${RST}"
    echo ""

    local i
    for ((i = 0; i < count; i++)); do
        if [[ $i -eq $selected ]]; then
            echo -e "  ${G2}${BOLD}${ICO_ARROW} ${options[$i]}${RST}"
        else
            echo -e "  ${DIM}  ${options[$i]}${RST}"
        fi
    done

    while true; do
        IFS= read -rsn1 key

        case "$key" in
            $'\x1b')
                read -rsn2 -t 0.01 rest
                case "$rest" in
                    '[A') ((selected > 0)) && ((selected--)) ;;
                    '[B') ((selected < count - 1)) && ((selected++)) ;;
                esac
                ;;
            'k') ((selected > 0)) && ((selected--)) ;;
            'j') ((selected < count - 1)) && ((selected++)) ;;
            '') break ;;
            'q'|'Q')
                echo -ne "$SHOW_CURSOR"
                echo ""
                echo -e "  ${DIM}Cancelled${RST}"
                return 1
                ;;
        esac

        for ((i = 0; i < count; i++)); do
            echo -ne "\033[A${CLEAR_LINE}"
        done

        for ((i = 0; i < count; i++)); do
            if [[ $i -eq $selected ]]; then
                echo -e "  ${G2}${BOLD}${ICO_ARROW} ${options[$i]}${RST}"
            else
                echo -e "  ${DIM}  ${options[$i]}${RST}"
            fi
        done
    done

    echo -ne "$SHOW_CURSOR"
    echo ""

    SELECTED_INDEX=$selected
    SELECTED_VALUE="${options[$selected]}"
    return 0
}

input_prompt() {
    local prompt="$1" default="${2:-}"
    local result

    if [[ -n "$default" ]]; then
        echo -ne "  ${BOLD}${prompt}${RST} ${DIM}(${default})${RST}: " >&2
    else
        echo -ne "  ${BOLD}${prompt}${RST}: " >&2
    fi
    if [[ -t 0 ]]; then
        read -r result
    elif [[ -e /dev/tty ]]; then
        read -r result </dev/tty
    else
        read -r result
    fi
    if [[ -z "$result" && -n "$default" ]]; then
        result="$default"
    fi
    result=$(echo "$result" | tr -d '\r' | xargs 2>/dev/null || echo "$result")
    echo "$result"
}

confirm() {
    local prompt="$1" default="${2:-y}"
    local yn

    if [[ "$default" == "y" ]]; then
        echo -ne "  ${BOLD}${prompt}${RST} ${DIM}[Y/n]${RST}: " >&2
    else
        echo -ne "  ${BOLD}${prompt}${RST} ${DIM}[y/N]${RST}: " >&2
    fi
    if [[ -t 0 ]]; then
        read -r yn
    elif [[ -e /dev/tty ]]; then
        read -r yn </dev/tty
    else
        read -r yn
    fi
    yn="${yn:-$default}"
    [[ "$yn" =~ ^[Yy] ]]
}

