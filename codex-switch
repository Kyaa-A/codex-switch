cmd_login() {
    show_mini_banner
    ensure_profiles_dir

    echo -e "  ${BOLD}${ICO_KEY} Add a new Codex account${RST}"
    echo ""

    local active
    active=$(get_active_profile)

    # Auto-save current session if exists so you NEVER lose it!
    if [[ -f "$AUTH_FILE" ]]; then
        if [[ -n "$active" ]]; then
            local current_dir="$PROFILES_DIR/$active"
            mkdir -p "$current_dir"
            cp "$AUTH_FILE" "$current_dir/auth.json"
            msg_info "Current profile '${BOLD}${active}${RST}' auto-saved"
            echo ""
        else
            msg_warn "Existing active Codex session detected!"
            msg_info "Saving your current session first so you don't lose it..."
            echo ""
            local prev_name
            prev_name=$(input_prompt "Name for your current logged-in account" "main")
            prev_name="${prev_name:-main}"
            cmd_save "$prev_name"
            echo ""
        fi
    fi

    msg_step "Opening Codex login..."
    echo ""

    # Run codex login
