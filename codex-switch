cmd_usage() {
    local target="${1:-}"
    show_mini_banner
    ensure_profiles_dir

    local active
    active=$(get_active_profile)

    if [[ -z "$target" ]]; then
        target="$active"
    fi

    if [[ "$target" == "all" ]]; then
        local profile_arr=()
        read -ra profile_arr <<< "$(get_profile_names)"
        for p in "${profile_arr[@]}"; do
            local auth_file="$PROFILES_DIR/$p/auth.json"
            get_profile_info "$p"
            local is_act="false"
            [[ "$p" == "$active" ]] && is_act="true"
            print_profile_card "$p" "$PROF_EMAIL" "$PROF_PLAN" "$is_act" "$PROF_SUB"
            echo ""
            show_codex_usage "$p" "$auth_file"
            echo ""
        done
        return
    fi

    if [[ -z "$target" ]]; then
        msg_error "No active profile tracked. Specify profile: codex-switch usage <name>"
        return 1
    fi

    local auth_file="$PROFILES_DIR/$target/auth.json"
    if [[ ! -f "$auth_file" ]]; then
        msg_error "Profile '$target' not found!"
        return 1
    fi

    get_profile_info "$target"
    local is_act="false"
    [[ "$target" == "$active" ]] && is_act="true"
    print_profile_card "$target" "$PROF_EMAIL" "$PROF_PLAN" "$is_act" "$PROF_SUB"
    echo ""
    show_codex_usage "$target" "$auth_file"
    echo ""
}

cmd_rename() {
    local old_name="${1:-}"
    local new_name="${2:-}"

    show_mini_banner
    ensure_profiles_dir

    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    if [[ ${#profile_arr[@]} -eq 0 ]]; then
        msg_warn "No profiles to rename"
        exit 0
    fi

    if [[ -z "$old_name" ]]; then
        local display_options=()
        for p in "${profile_arr[@]}"; do
            get_profile_info "$p"
            display_options+=("${BOLD}${p}${RST}  ${DIM}${PROF_EMAIL}${RST}")
        done

        if interactive_select "${ICO_STAR} Select profile to rename:" "${display_options[@]}"; then
            old_name="${profile_arr[$SELECTED_INDEX]}"
        else
            exit 0
        fi
    fi

    local old_dir="$PROFILES_DIR/$old_name"
    if [[ ! -d "$old_dir" ]]; then
        msg_error "Profile ${BOLD}'$old_name'${RST} not found!"
        exit 1
    fi

    if [[ -z "$new_name" ]]; then
        echo ""
        new_name=$(input_prompt "New name for '${old_name}'" "")
        if [[ -z "$new_name" ]]; then
            msg_error "New profile name cannot be empty"
            exit 1
        fi
    fi

    new_name=$(echo "$new_name" | tr -cd '[:alnum:]_-')
    if [[ -z "$new_name" ]]; then
        msg_error "New profile name must contain alphanumeric characters, '-', or '_'"
        exit 1
    fi

    local new_dir="$PROFILES_DIR/$new_name"
    if [[ -d "$new_dir" ]]; then
        msg_error "Profile ${BOLD}'$new_name'${RST} already exists!"
        exit 1
    fi

    mv "$old_dir" "$new_dir"

    local active
    active=$(get_active_profile)
    if [[ "$old_name" == "$active" ]]; then
        echo "$new_name" > "$ACTIVE_FILE"
    fi

    echo ""
    msg_success "Renamed profile ${BOLD}'$old_name'${RST} to ${BOLD}${BGREEN}'$new_name'${RST}"
    echo ""
}

cmd_delete() {
    local name="${1:-}"

    show_mini_banner
    ensure_profiles_dir

    if [[ -z "$name" ]]; then
        local profile_arr=()
        read -ra profile_arr <<< "$(get_profile_names)"

