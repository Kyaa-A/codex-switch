cmd_status() {
    show_mini_banner
    ensure_profiles_dir

    local active
    active=$(get_active_profile)

    if [[ -z "$active" ]]; then
        msg_info "No active profile tracked"
        msg_info "Save current session: ${BOLD}codex-switch save <name>${RST}"
        echo ""
        return
    fi

    echo -e "  ${BOLD}${ICO_BOLT} Current Codex Session${RST}"
