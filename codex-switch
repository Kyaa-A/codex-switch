# ── Profile helpers ────────────────────────────────────────────

get_profile_names() {
    local profiles=()
    if [[ -d "$PROFILES_DIR" ]]; then
        for dir in "$PROFILES_DIR"/*/; do
            [[ -d "$dir" ]] || continue
            profiles+=("$(basename "$dir")")
        done
    fi
    echo "${profiles[@]}"
}

get_profile_info() {
    local name="$1"
    local auth_file="$PROFILES_DIR/$name/auth.json"
    local info
    info=$(extract_codex_info "$auth_file")
    IFS='|' read -r PROF_MODE PROF_EMAIL PROF_ACCOUNT_ID <<< "$info"
}

# ── Commands ───────────────────────────────────────────────────

cmd_save() {
    local name="${1:-}"

    show_mini_banner

    if [[ -z "$name" ]]; then
        echo -e "  ${BOLD}Save current Codex session as a profile${RST}"
        echo ""
        name=$(input_prompt "${ICO_KEY} Profile name")
        if [[ -z "$name" ]]; then
            msg_error "Profile name cannot be empty"
            exit 1
        fi
    fi

    ensure_profiles_dir

    if [[ ! -f "$AUTH_FILE" ]]; then
        msg_error "No credentials found at ${ULINE}${AUTH_FILE}${RST}"
        msg_info "Login first: ${BOLD}codex login${RST}"
        exit 1
    fi

    local profile_dir="$PROFILES_DIR/$name"
    if [[ -d "$profile_dir" ]]; then
        echo ""
        msg_warn "Profile ${BOLD}'$name'${RST} already exists"
        if ! confirm "Overwrite?" "y"; then
            echo ""
            msg_info "Cancelled"
            exit 0
        fi
    fi

    mkdir -p "$profile_dir"
    cp "$AUTH_FILE" "$profile_dir/auth.json"
    echo "$name" > "$ACTIVE_FILE"

    echo ""
    msg_success "Profile ${BOLD}${BGREEN}'$name'${RST} saved!"
    echo ""

    get_profile_info "$name"
    print_profile_card "$name" "$PROF_EMAIL" "$PROF_MODE" "true"
    echo ""
}

cmd_use() {
    local name="${1:-}"

    show_mini_banner
    ensure_profiles_dir

    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    if [[ ${#profile_arr[@]} -eq 0 ]]; then
        msg_warn "No profiles saved yet"
        echo ""
        msg_info "Save your current session first:"
        echo -e "    ${BOLD}codex-switch save <name>${RST}"
        exit 1
    fi

    local active
    active=$(get_active_profile)

    if [[ -z "$name" ]]; then
        local display_options=()
        for p in "${profile_arr[@]}"; do
            get_profile_info "$p"
            local marker=""
            if [[ "$p" == "$active" ]]; then
                marker=" ${GREEN}(active)${RST}"
            fi
            display_options+=("${BOLD}${p}${RST}  ${DIM}${PROF_EMAIL}  [${PROF_MODE}]${RST}${marker}")
        done

        if interactive_select "${ICO_SWAP} Select Codex account to switch to:" "${display_options[@]}"; then
            name="${profile_arr[$SELECTED_INDEX]}"
        else
            exit 0
        fi
    fi

    local profile_dir="$PROFILES_DIR/$name"
    if [[ ! -f "$profile_dir/auth.json" ]]; then
        msg_error "Profile ${BOLD}'$name'${RST} not found!"
        echo ""
        exit 1
    fi

    if [[ "$name" == "$active" ]]; then
        msg_info "Already on profile ${BOLD}'$name'${RST}"
        exit 0
    fi

    # Auto-save current auth before switching so tokens are never lost!
    if [[ -n "$active" && -f "$AUTH_FILE" ]]; then
        local current_dir="$PROFILES_DIR/$active"
        mkdir -p "$current_dir"
        cp "$AUTH_FILE" "$current_dir/auth.json"
        msg_info "Auto-saved current profile '${BOLD}${active}${RST}'"
    fi

    # Switch auth
    cp "$profile_dir/auth.json" "$AUTH_FILE"
    echo "$name" > "$ACTIVE_FILE"

    echo ""
    msg_success "Switched to ${BOLD}${BGREEN}'$name'${RST}!"
    echo ""

    get_profile_info "$name"
    print_profile_card "$name" "$PROF_EMAIL" "$PROF_MODE" "true"

    echo ""
    msg_info "All your previous session history is preserved!"
    msg_info "Run ${BOLD}codex resume${RST} or use ${BOLD}/resume${RST} to continue any chat."
    echo ""
}

cmd_list() {
    show_mini_banner
    ensure_profiles_dir

    local active
    active=$(get_active_profile)

    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    if [[ ${#profile_arr[@]} -eq 0 ]]; then
        echo -e "  ${DIM}No profiles saved yet.${RST}"
        echo ""
        echo -e "  ${BOLD}Quick start:${RST}"
        echo -e "    ${CYAN}1.${RST} ${BOLD}codex-switch save <name>${RST}    ${DIM}# save current login${RST}"
        echo -e "    ${CYAN}2.${RST} ${BOLD}codex-switch login${RST}          ${DIM}# login to another account${RST}"
        echo -e "    ${CYAN}3.${RST} ${BOLD}codex-switch save <name>${RST}    ${DIM}# save that one too${RST}"
        echo -e "    ${CYAN}4.${RST} ${BOLD}codex-switch use <name>${RST}     ${DIM}# switch anytime!${RST}"
        echo ""
        return
    fi

    echo -e "  ${BOLD}${ICO_KEY} Saved Codex Profiles${RST} ${DIM}(${#profile_arr[@]} total)${RST}"
    echo ""

    for pname in "${profile_arr[@]}"; do
        local is_active="false"
        [[ "$pname" == "$active" ]] && is_active="true"

        get_profile_info "$pname"
        print_profile_card "$pname" "$PROF_EMAIL" "$PROF_MODE" "$is_active"
        echo ""
    done

    local scount
    scount=$(count_sessions)
    echo -e "  ${G3}${ICO_CHAT} Shared Sessions:${RST} ${BOLD}${scount}${RST} conversations available to ${BOLD}codex resume${RST}"
    echo ""
}

cmd_status() {
    show_mini_banner
    ensure_profiles_dir

    local active
    active=$(get_active_profile)

    if [[ -z "$active" ]]; then
        msg_info "No active profile tracked"
        msg_info "Save current session: ${BOLD}codex-switch save <name>${RST}"
        echo ""
        return
    fi

    echo -e "  ${BOLD}${ICO_BOLT} Current Codex Session${RST}"
    echo ""

    get_profile_info "$active"
    print_profile_card "$active" "$PROF_EMAIL" "$PROF_MODE" "true"

    echo ""
    msg_step "Verifying with Codex CLI..."
    if command -v codex &>/dev/null; then
        local live_status
        live_status=$(codex login status 2>&1 || echo "Logged out")
        if [[ "$live_status" == *"Logged in"* ]]; then
            msg_success "Session is ${BOLD}${GREEN}valid${RST} — ${live_status}"
        else
            msg_warn "Status: ${live_status}"
        fi
    fi

    local scount
    scount=$(count_sessions)
    echo ""
    msg_info "Shared session pool: ${BOLD}${scount}${RST} conversations available to ${BOLD}codex resume${RST}"
    echo ""
}

cmd_rename() {
    local old_name="${1:-}"
    local new_name="${2:-}"

    show_mini_banner
    ensure_profiles_dir

    local profile_arr=()
    read -ra profile_arr <<< "$(get_profile_names)"

    if [[ ${#profile_arr[@]} -eq 0 ]]; then
        msg_warn "No profiles to rename"
        exit 0
    fi

    if [[ -z "$old_name" ]]; then
        local display_options=()
        for p in "${profile_arr[@]}"; do
            get_profile_info "$p"
            display_options+=("${BOLD}${p}${RST}  ${DIM}${PROF_EMAIL}${RST}")
        done

        if interactive_select "${ICO_STAR} Select profile to rename:" "${display_options[@]}"; then
            old_name="${profile_arr[$SELECTED_INDEX]}"
        else
            exit 0
        fi
    fi

    local old_dir="$PROFILES_DIR/$old_name"
    if [[ ! -d "$old_dir" ]]; then
        msg_error "Profile ${BOLD}'$old_name'${RST} not found!"
        exit 1
    fi

    if [[ -z "$new_name" ]]; then
        echo ""
        new_name=$(input_prompt "New name for '${old_name}'" "")
        if [[ -z "$new_name" ]]; then
            msg_error "New profile name cannot be empty"
            exit 1
        fi
    fi

    local new_dir="$PROFILES_DIR/$new_name"
    if [[ -d "$new_dir" ]]; then
        msg_error "Profile ${BOLD}'$new_name'${RST} already exists!"
        exit 1
    fi

    mv "$old_dir" "$new_dir"

    local active
    active=$(get_active_profile)
    if [[ "$old_name" == "$active" ]]; then
        echo "$new_name" > "$ACTIVE_FILE"
    fi

    echo ""
    msg_success "Renamed profile ${BOLD}'$old_name'${RST} to ${BOLD}${BGREEN}'$new_name'${RST}"
    echo ""
}

cmd_delete() {
    local name="${1:-}"

    show_mini_banner
    ensure_profiles_dir

    if [[ -z "$name" ]]; then
        local profile_arr=()
        read -ra profile_arr <<< "$(get_profile_names)"

        if [[ ${#profile_arr[@]} -eq 0 ]]; then
            msg_warn "No profiles to delete"
            exit 0
        fi

        local display_options=()
        for p in "${profile_arr[@]}"; do
            get_profile_info "$p"
            display_options+=("${BOLD}${p}${RST}  ${DIM}${PROF_EMAIL}${RST}")
        done

        if interactive_select "${ICO_CROSS} Select profile to delete:" "${display_options[@]}"; then
            name="${profile_arr[$SELECTED_INDEX]}"
        else
            exit 0
        fi
    fi

    local profile_dir="$PROFILES_DIR/$name"
    if [[ ! -d "$profile_dir" ]]; then
        msg_error "Profile ${BOLD}'$name'${RST} not found!"
        exit 1
    fi

    echo ""
    get_profile_info "$name"
    print_profile_card "$name" "$PROF_EMAIL" "$PROF_MODE" "false"
    echo ""

    if ! confirm "${RED}Delete this profile?${RST}" "n"; then
        msg_info "Cancelled"
        exit 0
    fi

    local active
    active=$(get_active_profile)
    if [[ "$name" == "$active" ]]; then
        rm -f "$ACTIVE_FILE"
    fi

    rm -rf "$profile_dir"
    echo ""
    msg_success "Profile ${BOLD}'$name'${RST} deleted"
    echo ""
}

cmd_login() {
    show_mini_banner
    ensure_profiles_dir

    echo -e "  ${BOLD}${ICO_KEY} Add a new Codex account${RST}"
    echo ""

    local active
    active=$(get_active_profile)

    # Auto-save current session if exists so you NEVER lose it!
    if [[ -f "$AUTH_FILE" ]]; then
        if [[ -n "$active" ]]; then
            local current_dir="$PROFILES_DIR/$active"
            mkdir -p "$current_dir"
            cp "$AUTH_FILE" "$current_dir/auth.json"
            msg_info "Current profile '${BOLD}${active}${RST}' auto-saved"
            echo ""
        else
            msg_warn "Existing active Codex session detected!"
            msg_info "Saving your current session first so you don't lose it..."
            echo ""
            local prev_name
            prev_name=$(input_prompt "Name for your current logged-in account" "main")
            prev_name="${prev_name:-main}"
            cmd_save "$prev_name"
            echo ""
        fi
    fi

    msg_step "Opening Codex login..."
    echo ""

    # Run codex login
    codex login

    echo ""

    # Ask for profile name
    local name
    name=$(input_prompt "${ICO_KEY} Save new account as" "")
    if [[ -n "$name" ]]; then
        cmd_save "$name"
    else
        msg_info "Skipped saving. You can save later with: ${BOLD}codex-switch save <name>${RST}"
    fi
}

